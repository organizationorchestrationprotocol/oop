{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oop:machine-installation:2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "record_type",
    "machine_id",
    "authentication_identity",
    "owner_name",
    "owner_email",
    "collaborator_kind",
    "historical_machine_ids",
    "signing_identities",
    "runtimes"
  ],
  "properties": {
    "format": {
      "const": 2
    },
    "record_type": {
      "const": "machine_installation"
    },
    "machine_id": {
      "type": "string",
      "minLength": 1
    },
    "authentication_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "fingerprint",
        "credential_reference"
      ],
      "properties": {
        "scheme": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "credential_reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "owner_name": {
      "type": "string",
      "minLength": 1
    },
    "owner_email": {
      "type": "string",
      "minLength": 1
    },
    "collaborator_kind": {
      "type": "string",
      "minLength": 1
    },
    "historical_machine_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "signing_identities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scheme",
          "fingerprint",
          "mapping_reference"
        ],
        "properties": {
          "scheme": {
            "type": "string",
            "minLength": 1
          },
          "fingerprint": {
            "type": "string",
            "minLength": 1
          },
          "mapping_reference": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "runtimes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "installation_uid",
          "runtime_id",
          "first_installed_at",
          "first_installation_evidence"
        ],
        "properties": {
          "installation_uid": {
            "type": "string",
            "minLength": 1
          },
          "runtime_id": {
            "type": "string",
            "minLength": 1
          },
          "first_installed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "first_installation_evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
