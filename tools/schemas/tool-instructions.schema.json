{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OOP private tool integration instructions",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "tool_type", "workspace_ref", "source_ref", "applicability", "instructions", "authorizations"],
  "properties": {
    "format": {"const": 1},
    "tool_type": {"type": "string", "minLength": 1, "maxLength": 128},
    "workspace_ref": {"type": "string", "minLength": 1, "maxLength": 1024},
    "source_ref": {"type": "string", "minLength": 1, "maxLength": 1024},
    "applicability": {"type": "string", "minLength": 1, "maxLength": 2000},
    "instructions": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "authorizations": {"type": "array", "maxItems": 32, "items": {"type": "object", "description": "Complete authorization shape is defined by the source-bound knowledge contract; native consent remains independently installation-owned."}}
  }
}
