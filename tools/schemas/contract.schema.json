{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oop:derived:contract:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "source", "actor", "triggers", "scope", "dependencies", "preconditions", "actions", "postconditions", "verification", "prohibitions", "unknown", "failure", "recovery", "semantic_clause"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "locator", "content_identity"],
      "properties": {
        "path": {"const": "PROTOCOL.md"},
        "locator": {"type": "string", "minLength": 1},
        "content_identity": {"type": "string", "minLength": 1}
      }
    },
    "actor": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "triggers": {"$ref": "#/$defs/nonemptyStrings"},
    "dependencies": {"$ref": "#/$defs/strings"},
    "preconditions": {"$ref": "#/$defs/strings"},
    "actions": {"$ref": "#/$defs/nonemptyStrings"},
    "postconditions": {"$ref": "#/$defs/strings"},
    "verification": {"type": "string", "minLength": 1},
    "prohibitions": {"$ref": "#/$defs/strings"},
    "unknown": {"type": "string", "minLength": 1},
    "failure": {"type": "string", "minLength": 1},
    "recovery": {"type": "string", "minLength": 1},
    "semantic_clause": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "nonemptyStrings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
